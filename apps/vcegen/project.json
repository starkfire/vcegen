{
  "name": "vcegen",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vcegen/vcegen",
  "tags": [
    "type:app",
    "scope:backend",
    "lang:python"
  ],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync",
        "cwd": "apps/vcegen"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv lock",
        "cwd": "apps/vcegen"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run uvicorn vcegen.restapi:app --reload --port 8000",
        "cwd": "apps/vcegen"
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python vcegen.py",
        "cwd": "apps/vcegen",
        "forwardAllArgs": true
      }
    }
  }
}
