{
  "name": "@vcegen/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "nx run vcegen-app:serve",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "tauri:dev": "nx run vcegen-app:tauri-dev",
    "tauri:build": "nx run vcegen-app:tauri-build",
    "api:install": "nx run vcegen:install",
    "api:serve": "nx run vcegen:serve",
    "format": "prettier --write \"apps/vcegen-app/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@nx/eslint": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "nx": "23.2.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
